    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.chatwootUrl }}/api/v1/accounts/{{ $json.accountId }}/contacts/{{ $json.contactId }}/labels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Etiquetas atuais",
      "type": "n8n-nodes-base.httpRequest",
