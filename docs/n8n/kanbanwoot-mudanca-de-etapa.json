    },
    {
      "parameters": {
        "jsCode": "// Junta as etiquetas atuais do contato com as novas (o Chatwoot substitui a lista inteira)\nconst base = $('Escolher conversa').first().json;\nconst current = $input.first().json.payload || [];\nconst labels = [...new Set([...current, ...base.labels])];\nreturn [{ json: { ...base, labels, changed: labels.length !== current.length } }];\n"
      },
      "name": "Juntar etiquetas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
