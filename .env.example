REACT_APP_CHATWOOT_TOKEN=seu_token_aqui
REACT_APP_CHATWOOT_ACCOUNT_ID=1
REACT_APP_CHATWOOT_URL=https://app.chatwoot.com
REACT_APP_DEBUG=false
# Dias na mesma etapa até o card ser marcado como parado
REACT_APP_STALE_DAYS=7
# Etapas finais (vírgula); vazio = padrão: Ganho/Vendido/Fechado... e Perdido/Cancelado...
REACT_APP_WON_STAGES=
REACT_APP_LOST_STAGES=
# Motivos de perda sugeridos (vírgula); o agente também pode escrever outro
REACT_APP_LOST_REASONS=
# Atributo numérico com o valor do negócio e moeda (ISO 4217)
REACT_APP_VALUE_ATTRIBUTE=kbw_valor
REACT_APP_CURRENCY=BRL
# Atualização ao vivo, em segundos (0 desliga)
REACT_APP_REFRESH_SECONDS=30
# Campos obrigatórios por etapa: "Etapa:campo1,campo2;Outra etapa:campo3"
# (campos padrão: name, email, phone_number; o resto são chaves de atributos de contato)
REACT_APP_REQUIRED_FIELDS=
